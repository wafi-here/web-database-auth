<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= $name ?></title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #000000;
            color: #e2e2e2;
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            padding: 40px 20px;
            min-height: 100vh;
        }

        /* Layout Container */
        .container {
            width: 100%;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .card {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 24px;
            backdrop-filter: blur(10px);
        }

        .hero-card {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .avatar-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2); /* FIXED: solid keyword & RGBA format */
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            overflow: hidden;
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Prevents the image from stretching/distorting */
        }

        .avatar-icon {
            font-size: 48px;
            color: #888888;
        }

        .profile-name {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #baccb0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .green-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #39ff14;
            box-shadow: 0 0 8px #39ff14;
        }

        .grid-two-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        /* FIXED: @media syntax */
        @media (max-width: 500px) {
            .grid-two-columns {
                grid-template-columns: 1fr;
            }
        }

        .card-header {
            display: flex;
            align-items: center; /* FIXED: Removed double colon */
            gap: 8px;
            color: #888888;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .card-header .material-icons {
            font-size: 16px;
        }

        .card-value {
            font-size: 18px;
            font-weight: 600;
        }

        /* Academic Record List */
        .list-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .list-item:last-child {
            border-bottom: none;
        }

        .list-label {
            color: #888888;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Highlighted Card */
        .card-highlight {
            border-color: #39ff14;
            box-shadow: 0 0 15px rgba(57, 255, 20, 0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .highlight-text {
            color: #39ff14;
        }

        .large-status {
            font-size: 36px;
            font-weight: 700;
            margin-top: 4px;
            text-transform: capitalize;
        }
    </style>
</head>
<body>
    <main class="container">

        <!-- Hero Card -->
        <section class="card hero-card">
            <div class="avatar-circle">
                <img src="profile.jpeg" alt="<?= $name ?>" class="avatar-img">
            </div>
            <h1 class="profile-name"><?= $name ?></h1>
            <div class="badge-status">
                <span class="green-dot"></span>
                <span>Age <?= $age ?></span>
            </div>
        </section>

        <!-- Two Column Grid: Location & Sex -->
        <section class="grid-two-columns">
            <div class="card">
                <div class="card-header">
                    <span class="material-icons">location_on</span>
                    <span>Location</span>
                </div>
                <p class="card-value"><?= $address ?></p>
            </div>

            <div class="card">
                <div class="card-header">
                    <span class="material-icons">fingerprint</span>
                    <span>Biological Sex</span>
                </div>
                <p class="card-value"><?= $gender ?></p>
            </div>
        </section>

        <!-- Academic Record Section -->
        <section class="card">
            <div class="card-header highlight-text">
                <span class="material-icons">school</span>
                <span>Academic Record</span>
            </div>

            <div class="list-item">
                <span class="list-label">Class</span>
                <span class="card-value">Year <?= $class ?></span>
            </div>

            <div class="list-item">
                <span class="list-label">Specialization</span>
                <span class="card-value"><?= $specialization ?></span>
            </div>

            <div class="list-item">
                <span class="list-label">Focus Area</span>
                <span class="card-value"><?= $subject[1] ?></span>
            </div>
        </section>

        <!-- Social Status Section -->
        <section class="card card-highlight">
            <div>
                <div class="card-header highlight-text">
                    <span class="material-icons">favorite</span>
                    <span>Social Status</span>
                </div>
                <p class="large-status"><?= $status_label ?></p>
            </div>

            <!-- FIXED: Style syntax for dot -->
            <div class="green-dot" style="width: 12px; height: 12px;"></div>
        </section>

    </main>
</body>
</html>